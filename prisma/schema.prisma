generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  etudiant
  enseignant
  admin
  jury
}

enum CycleMode {
  online
  hybride
  presentiel
}

enum SessionStatus {
  propose
  valide
  rejete
}

enum SessionKind {
  campus
  live
  async
  examen
}

enum ExamStatus {
  draft
  published
  closed
}

enum SlotStatus {
  propose
  valide
  rejete
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        Role     @default(etudiant)
  avatarColor String   @default("bg-indigo-600")
  school      String?
  level       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentSetting StudentSetting?
  slotRequests   SlotRequest[]
  courseProgress CourseProgress[]
  examAttempts   ExamAttempt[]
  forumPosts     ForumPost[]
  enrollments    Enrollment[]
  taughtCourses  Course[]         @relation("TeacherCourses")

  @@map("users")
}

// ─── Courses ─────────────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  coverUrl    String?
  ueId        String
  teacherId   String
  semester    Int      @default(1)
  isPublished Boolean  @default(false)
  hasAI       Boolean  @default(false)
  objectives  String[]
  competences String[]
  prerequis   String?
  audience    String?
  evaluation  String?
  volume      String?
  difficulte  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  ue          UE           @relation(fields: [ueId], references: [id])
  chapters    Chapter[]
  sessions    Session[]
  enrollments Enrollment[]
  exams       Exam[]

  @@map("courses")
}

model UE {
  id      String   @id @default(cuid())
  code    String   @unique
  title   String
  credits Int      @default(3)
  courses Course[]

  @@map("ues")
}

model Chapter {
  id         String    @id @default(cuid())
  courseId   String
  title      String
  order      Int
  contentUrl String?
  videoUrl   String?
  duration   Int?
  createdAt  DateTime  @default(now())

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress CourseProgress[]

  @@map("chapters")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model CourseProgress {
  id          String    @id @default(cuid())
  userId      String
  chapterId   String
  percent     Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, chapterId])
  @@map("course_progress")
}

// ─── Planning ────────────────────────────────────────────────────────────────

model Session {
  id         String        @id @default(cuid())
  courseId   String
  title      String
  day        String
  start      String
  end        String
  kind       SessionKind
  room       String?
  modes      CycleMode[]
  proposedBy String
  status     SessionStatus @default(propose)
  semester   Int           @default(1)
  createdAt  DateTime      @default(now())

  course Course @relation(fields: [courseId], references: [id])

  @@map("sessions")
}

model CalendarEvent {
  id       String @id @default(cuid())
  date     String
  label    String
  type     String
  semester Int    @default(1)

  @@map("calendar_events")
}

model StudentSetting {
  id            String    @id @default(cuid())
  userId        String    @unique
  mode          CycleMode @default(hybride)
  deadlineWeeks Int       @default(12)

  user User @relation(fields: [userId], references: [id])

  @@map("student_settings")
}

model SlotRequest {
  id        String     @id @default(cuid())
  userId    String
  day       String
  start     String
  end       String
  ue        String
  note      String?
  status    SlotStatus @default(propose)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("slot_requests")
}

// ─── Examens ─────────────────────────────────────────────────────────────────

model Exam {
  id           String     @id @default(cuid())
  courseId     String
  title        String
  instructions String?
  duration     Int        @default(120)
  status       ExamStatus @default(draft)
  startsAt     DateTime?
  createdAt    DateTime   @default(now())

  course    Course        @relation(fields: [courseId], references: [id])
  questions Question[]
  attempts  ExamAttempt[]

  @@map("exams")
}

model Question {
  id      String   @id @default(cuid())
  examId  String
  body    String
  options String[]
  answer  Int
  points  Int      @default(1)
  order   Int

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@map("questions")
}

model ExamAttempt {
  id          String    @id @default(cuid())
  examId      String
  userId      String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?

  exam    Exam     @relation(fields: [examId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  answers Answer[]

  @@unique([examId, userId])
  @@map("exam_attempts")
}

model Answer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  chosen     Int

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answers")
}

// ─── Forum ───────────────────────────────────────────────────────────────────

model ForumPost {
  id        String    @id @default(cuid())
  courseId  String?
  authorId  String
  body      String
  parentId  String?
  createdAt DateTime  @default(now())

  author  User        @relation(fields: [authorId], references: [id])
  parent  ForumPost?  @relation("Replies", fields: [parentId], references: [id])
  replies ForumPost[] @relation("Replies")

  @@map("forum_posts")
}
